# RepairPassport environment variables
# ------------------------------------
# This file lists the variable NAMES the app needs, with placeholder values.
# It is committed to Git so others know what to set up.
#
# To run the app:
#   1. Copy this file to `.env.local` (Git ignores that file).
#   2. Replace the placeholders with your real values from Supabase:
#      Project dashboard → Connect (or Project Settings → API Keys).
#
# Never put real keys in this file.

# Your Supabase project's URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# The project's PUBLISHABLE key (starts with sb_publishable_).
# Safe to use in the browser: Row Level Security controls what it can access.
# Do NOT use the secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
